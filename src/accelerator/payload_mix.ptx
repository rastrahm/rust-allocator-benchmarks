//
// Precompiled PTX for payload_mix (GPU C).
// Kernel: out[i] = in[i] ^ 0xDEADBEEF ^ i
//
.version 7.0
.target sm_75
.address_size 64

.visible .entry payload_mix(
    .param .u64 payload_mix_param_0,
    .param .u64 payload_mix_param_1,
    .param .u32 payload_mix_param_2
)
{
    .reg .pred      %p<2>;
    .reg .b32       %r<10>;
    .reg .b64       %rd<8>;

    mov.u32         %r1, %ctaid.x;
    mov.u32         %r2, %ntid.x;
    mov.u32         %r3, %tid.x;
    mad.lo.s32      %r4, %r1, %r2, %r3;

    ld.param.u32    %r5, [payload_mix_param_2];
    setp.ge.s32     %p1, %r4, %r5;
    @%p1 bra        $L__EXIT;

    ld.param.u64    %rd1, [payload_mix_param_0];
    ld.param.u64    %rd2, [payload_mix_param_1];
    mul.wide.s32    %rd3, %r4, 4;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.u32   %r6, [%rd4];

    xor.b32         %r7, %r6, 0xDEADBEEF;
    xor.b32         %r8, %r7, %r4;

    add.s64         %rd5, %rd2, %rd3;
    st.global.u32   [%rd5], %r8;

$L__EXIT:
    ret;
}
